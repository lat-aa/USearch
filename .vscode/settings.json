{
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "cSpell.words": [
    "ashvardanian",
    "BFLOAT",
    "BLAS",
    "DUSEARCH",
    "dylib",
    "FAISS",
    "fbin",
    "furo",
    "googleanalytics",
    "groundtruth",
    "HNSW",
    "hnswlib",
    "ibin",
    "jaccard",
    "Jemalloc",
    "libjemalloc",
    "libomp",
    "MSVC",
    "numkong",
    "OPENMP",
    "Quickstart",
    "relwithdebinfo",
    "SIMD",
    "SLOC",
    "sorensen",
    "stringzilla",
    "tanimoto",
    "usearch",
    "Vardanian"
  ],
  "editor.insertSpaces": true,
  "editor.tabSize": 4,
  "files.watcherExclude": {
    "**/build_*/**": true,
    "**/datasets/**": true,
    "**/numkong/**": true,
    "**/stringzilla/**": true
  },
  "search.exclude": {
    "**/build_*/**": true,
    "**/datasets/**": true,
    "**/numkong/**": true,
    "**/stringzilla/**": true
  },
  "yaml.format.bracketSpacing": false,
  "yaml.format.printWidth": 120,
  "yaml.format.singleQuote": false
}
